{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Grip",
  "version": "1.0.0",
  "identifier": "com.ameliiom.grip",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Grip",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Lightweight studio for Razer mice and peripherals",
    "publisher": "ameliiom",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
